# Postgres (asyncpg driver). In docker compose the host is `db`.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/medibuddy

# Telegram
TELEGRAM_BOT_TOKEN=
# Required. Generate one (e.g. `openssl rand -hex 32`) and register it with
# Telegram, otherwise /webhook rejects every request:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#     -d "url=https://<host>/webhook" -d "secret_token=<SECRET>"
TELEGRAM_WEBHOOK_SECRET=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

REDIS_URL=redis://localhost:6379/1

VOICE_MAX_DURATION_SECONDS=45
SCHEDULER_INTERVAL_SECONDS=60
REMINDER_PRECOMPUTE_DAYS=7
REFILL_ALERT_DAYS_BEFORE=5
# Minimum gap between two 'running low' alerts for the same medication.
REFILL_REALERT_COOLDOWN_DAYS=3
PENDING_ACTION_TTL_MINUTES=30
USER_TIMEZONE=Asia/Kolkata

# Telegram HTTP budgets (seconds). A tight connect budget turns an event-loop
# stall into a spurious ConnectTimeout even on a healthy network.
TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_CONNECT_TIMEOUT_SECONDS=10

# A dose reminder later than this is retired undelivered rather than sent as
# though it were due now. Refill alerts are unaffected.
REMINDER_MAX_LATENESS_MINUTES=120

# Per-Telegram-user request budget per minute.
USER_RATE_LIMIT_PER_MINUTE=20

DEBUG=false
# Logs full request bodies, which contain user health data. Development only.
LOG_REQUESTS=false
